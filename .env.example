# ============================================================
# KrishiMitra AI — Environment Variables Template
# ============================================================
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.
# ============================================================

# --- IBM watsonx.ai Credentials ---
# Obtain from: https://cloud.ibm.com/iam/apikeys
IBM_WATSONX_API_KEY=

# Your watsonx.ai project ID (not the IBM Cloud project ID)
# Obtain from: watsonx.ai → Manage → General → Project ID
IBM_WATSONX_PROJECT_ID=

# Regional endpoint — change if your instance is in a different region
# Options: https://us-south.ml.cloud.ibm.com  |  https://eu-de.ml.cloud.ibm.com  |  https://jp-tok.ml.cloud.ibm.com
IBM_WATSONX_URL=https://us-south.ml.cloud.ibm.com

# --- IBM Granite Model ---
# Granite model to use for response generation
# See: https://dataplatform.cloud.ibm.com/docs/content/wsj/analyze-data/fm-models.html
IBM_GRANITE_MODEL_ID=ibm/granite-4-h-small

# --- IBM Embedding Model ---
# Embedding model used for RAG vector indexing and query encoding
IBM_EMBEDDING_MODEL_ID=ibm/granite-embedding-278m-multilingual

# --- ChromaDB Vector Store ---
# Path where ChromaDB will persist its data on disk
CHROMA_PERSIST_DIR=./data/chroma_db

# Name of the ChromaDB collection that holds the knowledge-base embeddings
CHROMA_COLLECTION_NAME=krishimitra_kb

# --- Application Settings ---
# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Comma-separated list of allowed CORS origins for the frontend
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:5500","http://localhost:5500"]
